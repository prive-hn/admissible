{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admissible/protocol/calibration-journal-event.schema.json",
  "title": "CalibrationJournalEvent",
  "description": "A single append-only calibration-ledger journal event, as emitted by rga.calibration.CalibrationAuthority and documented in metrics/SCHEMA.md (Calibration events). A language-neutral restatement of that contract; it adds no fields the machine does not already emit. The 'type' discriminator selects the variant.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {"type": "string", "enum": ["cal_run", "cal_replay", "cal_discredit", "cal_adjudicate", "cal_exclude", "cal_install", "cal_stamp", "cal_close"]},
    "ts": {"type": "number"}
  },
  "$defs": {
    "runVerdict": {"type": "string", "enum": ["refuted", "survived"]},
    "trackRecord": {
      "type": "object",
      "required": ["charged_cells", "seals_participated", "corpus_size", "corpus_excluded", "as_of"],
      "properties": {
        "charged_cells": {"type": "integer", "minimum": 0},
        "seals_participated": {"type": "integer", "minimum": 0},
        "corpus_size": {"type": "integer", "minimum": 0},
        "corpus_excluded": {"type": "integer", "minimum": 0},
        "as_of": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "cal_run"}}},
      "then": {
        "required": ["run_index", "line_id", "class", "claim_id", "checker_id", "checker_version", "tier", "nonce", "artifact_hash", "seed", "verdict", "witness_hash", "finder"],
        "properties": {
          "run_index": {"type": "integer", "minimum": 0},
          "line_id": {"type": "string"},
          "class": {"type": "string"},
          "claim_id": {"type": "string"},
          "checker_id": {"type": "string"},
          "checker_version": {"type": "string"},
          "tier": {"type": "string", "enum": ["A", "B"]},
          "nonce": {"type": "string"},
          "artifact_hash": {"type": "string"},
          "seed": {"type": "string"},
          "verdict": {"$ref": "#/$defs/runVerdict"},
          "witness_hash": {"type": "string"},
          "finder": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "cal_replay"}}},
      "then": {
        "required": ["run_index", "verdict", "witness_hash", "diverged"],
        "properties": {
          "run_index": {"type": "integer", "minimum": 0},
          "verdict": {"$ref": "#/$defs/runVerdict"},
          "witness_hash": {"type": "string"},
          "diverged": {"type": "boolean"}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "cal_discredit"}}},
      "then": {
        "required": ["checker_id", "checker_version", "run_index"],
        "properties": {
          "checker_id": {"type": "string"},
          "checker_version": {"type": "string"},
          "run_index": {"type": "integer", "minimum": 0}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "cal_adjudicate"}}},
      "then": {
        "required": ["run_index", "actor", "decision", "reason"],
        "properties": {
          "run_index": {"type": "integer", "minimum": 0},
          "actor": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "enum": ["accept", "reject"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "cal_exclude"}}},
      "then": {
        "required": ["class", "as_of", "run_indices", "actor", "reason", "corpus_size", "excluded_total"],
        "properties": {
          "class": {"type": "string"},
          "as_of": {"type": "integer", "minimum": 0},
          "run_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "actor": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "corpus_size": {"type": "integer", "minimum": 0},
          "excluded_total": {"type": "integer", "minimum": 1}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "cal_install"}}},
      "then": {
        "required": ["policy_version", "calibration_policy_version", "as_of", "budgets", "coverage", "dropped_defect_ids", "dropped_classes"],
        "properties": {
          "policy_version": {"type": "string"},
          "as_of": {"type": "integer", "minimum": 0},
          "calibration_policy_version": {"type": "string"},
          "budgets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["e_max", "demotion_gate"],
              "properties": {
                "e_max": {"type": "integer", "minimum": 0},
                "demotion_gate": {"type": "string", "enum": ["seal", "carry"]}
              }
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["corpus_size", "excluded", "models"],
              "properties": {
                "corpus_size": {"type": "integer", "minimum": 0},
                "excluded": {"type": "integer", "minimum": 0},
                "models": {"type": "object", "additionalProperties": {"type": "string"}}
              }
            }
          },
          "dropped_defect_ids": {"type": "array", "items": {"type": "string"}},
          "dropped_classes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "cal_stamp"}}},
      "then": {
        "required": ["line_id", "sealed_at", "track_records", "corpus_provenance"],
        "properties": {
          "line_id": {"type": "string"},
          "sealed_at": {"type": "integer", "minimum": 0},
          "track_records": {"type": "object", "additionalProperties": {"$ref": "#/$defs/trackRecord"}},
          "corpus_provenance": {
            "type": "object",
            "required": ["finder_is_generator", "independent"],
            "properties": {
              "finder_is_generator": {"type": "integer", "minimum": 0},
              "independent": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "cal_close"}}},
      "then": {
        "required": ["line_id", "fault", "as_of", "refuter_id", "refuter_version", "primaries"],
        "properties": {
          "line_id": {"type": "string"},
          "fault": {"const": "E5"},
          "as_of": {"type": "integer", "minimum": 0},
          "refuter_id": {"type": "string"},
          "refuter_version": {"type": "string"},
          "primaries": {"$ref": "#/$defs/trackRecord"}
        }
      }
    }
  ]
}
